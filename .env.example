# Copy to .env and fill in ONE provider.

# Option 1: Claude (paid API credits)
ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Google Gemini free tier (key from https://aistudio.google.com/apikey)
# TW_PROVIDER=gemini
# GEMINI_API_KEY=...

# Option 3: local model with Ollama (free; install from https://ollama.com, then: ollama pull qwen3:8b)
# TW_PROVIDER=ollama

# Optional overrides
# TW_MODEL=            # override the provider's default model
# TW_EFFORT=high
# TW_VERIFIER_EFFORT=medium
# TW_MAX_STEPS=40
